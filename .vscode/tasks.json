{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Show Docs",
            "type": "shell",
            "command": "uv run sphinx-build -b html -c . ../content build && start build\\index.html",
            "options": {
                "cwd": "${workspaceFolder}\\sphinx",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Live Reload Docs",
            "type": "shell",
            "command": "uv run sphinx-autobuild -b html -c . ../content build --open-browser",
            "options": {
                "cwd": "${workspaceFolder}\\sphinx",
                "shell": {
                    "executable": "cmd.exe",
                    "args": ["/d", "/c"]
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
